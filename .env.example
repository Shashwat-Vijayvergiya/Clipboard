# Upstash Redis / Vercel KV Environment Variables
# (These are automatically injected by Vercel when you connect Upstash KV in the Vercel Dashboard)

UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Or Vercel KV format (also auto-supported):
# KV_REST_API_URL="https://your-kv-instance.upstash.io"
# KV_REST_API_TOKEN="your_kv_token"
